# Logging
#
# LOG_DIR can be absolute (e.g. /var/log/gree) or relative to project root (e.g. local/logs).
# Warning / Error / Critical are written unconditionally.
LOG_DIR=local/logs
LOG_DEBUG=false

# Tests
#
# Base URL used by integration tests (local/tests/Integration/*). Override
# per-run with `TEST_BASE_URL=… composer test:integration`. Defaults to the
# local dev URL.
TEST_BASE_URL=https://gree:8890

# Switches bootstrap (local/tests/bootstrap.php) into integration mode:
# loads real Bitrix prolog instead of class-aliased stubs. Set to "1" via the
# `composer test:integration` script — usually you do NOT need to touch this
# in .env. Document here so it's discoverable.
# GREE_TEST_INTEGRATION=1

# Explicit MySQL unix-socket path for the CLI mysqli connection used by
# integration tests. Bootstrap probes common locations automatically
# (MAMP / brew / apt / rpm); set this only if your MySQL socket is elsewhere.
# GREE_TEST_MYSQL_SOCKET=/path/to/mysql.sock

# Security
#
# Comma-separated list of hosts (host or host:port) ApiGuard treats as
# trusted Origin/Referer source for state-changing API calls. By default
# the guard reads HTTP_HOST + X-Forwarded-Host from the active request;
# but behind a reverse proxy / CDN those can be wrong (internal hostname
# instead of the public one). Set this env on prod to nail down the
# public host(s).
# GREE_ALLOWED_HOSTS=gree.all4it.org,www.gree.all4it.org

# E-mail — уведомления менеджеру о новых заказах
#
# Читаются в Gree\Mail\BitrixMailer (получатели + From) и services.php
# (admin URL). Пустой ORDER_MAIL_TO → уведомления выключены (no-op): на
# локалке/тестах заказ оформляется без отправки письма.
#
# ORDER_MAIL_TO    — получатель(и) через запятую (sales@gree.ru,manager@gree.ru).
# ORDER_MAIL_FROM  — адрес отправителя (опционально; пусто → дефолт Bitrix).
# ORDER_ADMIN_URL  — базовый абсолютный URL сайта для ссылки в кастомную деталку
#                    заказа (/bitrix/admin/gree_orders_view.php?ID=). Пусто → в
#                    письме не будет ссылки в админку.
# ORDER_MAIL_TO=sales@gree.ru
# ORDER_MAIL_FROM=no-reply@gree.ru
# ORDER_ADMIN_URL=https://gree.all4it.org
