{
    "name": "gree/app",
    "type": "project",
    "require": {
        "php": "^8.4",
        "doctrine/collections": "^2.0",
        "illuminate/view": "^11.0",
        "symfony/dependency-injection": "^7.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "Gree\\": "local/lib/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Gree\\Tests\\": "local/tests/"
        }
    },
    "config": {
        "vendor-dir": "vendor",
        "optimize-autoloader": true,
        "sort-packages": true
    }
}
